{
  "name": "@useavalon/caelence-agent",
  "version": "0.2.1",
  "description": "Caelence agent: Strands turn loop, local tools, skills, evals, and a themable terminal UI.",
  "type": "module",
  "license": "MIT",
  "author": "useAvalon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useAvalon/caelence-agent.git"
  },
  "homepage": "https://github.com/useAvalon/caelence-agent#readme",
  "bugs": {
    "url": "https://github.com/useAvalon/caelence-agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "caelence": "./bin/harness.ts",
    "caelence-agent": "./bin/harness.ts",
    "harness": "./bin/harness.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli/main.ts",
    "./observability": "./src/observability/index.ts"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "brand",
    "desktop",
    "README.md"
  ],
  "scripts": {
    "start": "bun bin/harness.ts",
    "test": "bun test src/core src/tools src/skills src/evals src/cli src/observability src/desktop src/integrations src/media src/init.test.ts src/runtime.test.ts desktop/src/rich-text.test.ts desktop/src/stream.test.ts desktop/src/dictation.test.ts desktop/src/thought.test.ts desktop/src/queue.test.ts desktop/src/composer-files.test.ts desktop/src/tool-label.test.ts desktop/src/reply-sources.test.ts desktop/src/pipeline.test.ts desktop/src/preview-render.test.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:exports": "node scripts/check-exports.mjs",
    "prepare": "[ -d .git ] && husky || true",
    "prepublishOnly": "bun run typecheck && bun run test && bun run check:exports",
    "desktop": "bun src/cli/main.ts desktop"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,mjs}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.10.0",
    "ink": "^5.2.1",
    "openai": "^6.45.0",
    "react": "^18.3.1"
  },
  "optionalDependencies": {
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.222.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.18",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3"
  }
}
